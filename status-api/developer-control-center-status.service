[Unit]
Description=Developer Control Center read-only status API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/developer-control-center/status-api
EnvironmentFile=/etc/developer-control-center/status-api.env
ExecStart=/usr/bin/env node /opt/developer-control-center/status-api/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
CapabilityBoundingSet=
LockPersonality=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
