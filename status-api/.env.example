STATUS_API_PORT=18787
STATUS_SERVICE_TOKEN=replace-with-a-long-random-token
STATUS_SERVICE_TOKEN_PREVIOUS=
STATUS_GIT_COMMIT=local
STATUS_SERVICES_JSON='[{"name":"Polymarket Bot","url":"http://127.0.0.1:8000/health"},{"name":"Bitbank Bot","url":"http://127.0.0.1:8001/health"}]'
STATUS_PNL_SUMMARY_JSON='null'
STATUS_ENABLE_DOCKER_DISCOVERY=false
# `running` removes stopped containers from the live service list; use `all` to include stopped containers.
STATUS_DOCKER_DISCOVERY_MODE=running
# `merge` keeps explicit health checks; `replace` uses only discovered Docker containers.
STATUS_SERVICE_DISCOVERY_MODE=merge
# JSON thresholds: warning/critical values are percentages.
STATUS_ALERT_RULES_JSON='{"cpu":{"warning":90,"critical":95},"memory":{"warning":90,"critical":95},"disk":{"warning":85,"critical":95},"serviceDown":{"enabled":true}}'
# Public HTTP/HTTPS checks. HTTPS checks also inspect certificate expiry.
STATUS_EXTERNAL_CHECKS_JSON='[{"id":"public-api","name":"Public API","url":"https://example.com/health","expectedStatus":200,"timeoutMs":3000,"tlsWarningDays":30,"tlsCriticalDays":7}]'
