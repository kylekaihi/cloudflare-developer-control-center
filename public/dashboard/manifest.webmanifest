{
  "name": "Developer Control Center",
  "short_name": "Control Center",
  "description": "Read-only runtime dashboard for Cloudflare and VPS nodes.",
  "lang": "zh-CN",
  "dir": "ltr",
  "start_url": "/dashboard/?source=pwa",
  "scope": "/dashboard/",
  "id": "/dashboard/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#111615",
  "theme_color": "#111615",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "/dashboard/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/dashboard/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/dashboard/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/dashboard/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "查看告警",
      "short_name": "告警",
      "description": "Open active infrastructure alerts",
      "url": "/dashboard/#alerts-panel",
      "icons": [{ "src": "/dashboard/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "查看 VPS 节点",
      "short_name": "节点",
      "description": "Open the Mesh node status panel",
      "url": "/dashboard/#nodes-panel",
      "icons": [{ "src": "/dashboard/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
