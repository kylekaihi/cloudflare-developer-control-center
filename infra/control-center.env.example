# Cloudflare API token permissions:
# - Account: Access Apps and Policies Write
# - Account: Account Settings Read
# - Account: D1 Edit
# - Account: Workers Scripts Edit
# - Account: Pages Edit
CLOUDFLARE_API_TOKEN=
# Optional with Wrangler OAuth, but required when OAuth lacks Access scope.
CLOUDFLARE_ACCESS_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Example: your-team.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=

# Comma-separated operators who may sign in.
ACCESS_ALLOWED_EMAILS=you@example.com

DASHBOARD_HOST=dashboard.example.com
D1_DATABASE_NAME=developer-control-center-monitoring
PAGES_PROJECT_NAME=developer-control-center
STATUS_WORKER_URL=https://developer-control-center-status.your-subdomain.workers.dev

# Optional when these secrets already exist on developer-control-center-status.
STATUS_SERVICE_TOKEN=
# Used only during a staged token rotation; leave empty normally.
STATUS_SERVICE_TOKEN_PREVIOUS=
STATUS_API_TOKEN=

# Optional. Notifications remain disabled when either value is empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Recommended for authenticated Pages Function and PWA acceptance checks.
# Create a Cloudflare Access service token and allow it in the Access app policy.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# SSH endpoints. Each meshHost must match STATUS_SERVICE_HOSTS in the Worker config.
VPS_DEPLOY_TARGETS=[{"name":"vps-1","sshHost":"vps1.example.com","sshPort":22,"sshUser":"root","meshHost":"100.96.0.10"},{"name":"vps-2","sshHost":"vps2.example.com","sshPort":22,"sshUser":"root","meshHost":"100.96.0.11"},{"name":"vps-3","sshHost":"vps3.example.com","sshPort":22,"sshUser":"root","meshHost":"100.96.0.12"}]
VPS_SSH_IDENTITY_FILE=
VPS_STATUS_SERVICES_JSON=[]
VPS_STATUS_PNL_SUMMARY_JSON=null
# Disabled by default because Docker socket access is root-equivalent.
STATUS_ENABLE_DOCKER_DISCOVERY=false

# Recovery and verification controls.
AUTO_ROLLBACK_ON_FAILURE=true
SKIP_VPS_DEPLOY=false
POST_DEPLOY_TIMEOUT_SECONDS=90
