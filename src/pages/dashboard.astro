        renderControlAudit(host);
        nodeLogs.textContent = t("selectLogs");
        if (!nodeDialog.open) nodeDialog.showModal();
      }

      async function loadControls() {
        try {
          const response = await fetch(apiUrl("controls"), { credentials: "same-origin" });
          if (!response.ok) return;
          const payload = await response.json();
          controlCache = { services: Array.isArray(payload.services) ? payload.services : [], audit: Array.isArray(payload.audit) ? payload.audit : [] };
        } catch { /* management controls remain hidden */ }
      }

      async function loadMaintenance() {
        try {
          const response = await fetch(apiUrl("maintenance"), { credentials: "same-origin" });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(payload.error || "maintenance unavailable");
          const rows = Array.isArray(payload.data) ? payload.data : [];
          maintenanceCount.textContent = rows.length ? `${rows.length} ${t("active").toLowerCase()}` : "—";
          maintenance.innerHTML = rows.length ? rows.map((item) => `<article class="maintenance-row"><div><strong>${safe(item.serviceName || t("maintenanceGlobal"))}</strong><small>${safe(item.host || t("maintenanceGlobal"))} · ${safe(t("maintenanceUntil"))} ${safe(formatDate(item.endsAt))}</small><small>${safe(item.reason)}</small></div><button type="button" class="is-danger" data-maintenance-delete="${safe(item.id)}">${safe(t("removeMaintenance"))}</button></article>`).join("") : `<p class="empty-state">${t("maintenanceEmpty")}</p>`;
        } catch { maintenanceCount.textContent = "—"; maintenance.innerHTML = `<p class="empty-state">${t("maintenanceEmpty")}</p>`; }
      }

      async function addMaintenance() {
        const host = window.prompt(t("maintenancePromptHost"));
        if (host === null) return;
        const serviceName = window.prompt(t("maintenancePromptService"));
        if (serviceName === null) return;
        const minutes = Number(window.prompt(t("maintenancePromptMinutes"), "60"));
        const reason = window.prompt(t("maintenancePromptReason"));
        if (!Number.isFinite(minutes) || minutes <= 0 || !reason) return;
        const response = await fetch(apiUrl("maintenance"), { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ host, serviceName, startsAt: new Date().toISOString(), endsAt: new Date(Date.now() + minutes * 60_000).toISOString(), reason }) });
        if (response.ok) { await loadMaintenance(); showPwaNotice("maintenanceCreated", null, null, "online"); } else showPwaNotice("maintenanceFailed", null, null, "offline");
      }

      async function removeMaintenance(id) {
        const url = apiUrl("maintenance"); url.searchParams.set("id", id);
        const response = await fetch(url, { method: "DELETE", credentials: "same-origin" });
        if (response.ok) await loadMaintenance();
      }

      function renderControlAudit(host) {
        const rows = controlCache.audit.filter((item) => item.host === host).slice(0, 10);
        controlAudit.innerHTML = rows.length ? rows.map((item) => `<div><span><strong>${safe(item.name)} · ${safe(item.action)}</strong><small>${safe(item.actor)} · ${safe(formatDate(item.createdAt))}</small></span><span>${safe(item.status)}</span></div>`).join("") : `<p class="empty-state">${t("noData")}</p>`;
      }

      async function runControlAction(action, host, name) {
        let confirmation = null;
        if (action === "restart") {
          confirmation = window.prompt(`${t("restartPrompt")}: ${name}`);
          if (confirmation !== name) return;
        }
        if (action === "logs") nodeLogs.textContent = t("loading");
        const response = await fetch(apiUrl("controls"), { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ requestId: crypto.randomUUID(), action, host, name, confirmation, lines: 150 }) });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok) { nodeLogs.textContent = payload.error || t("actionFailed"); return; }
        if (action === "logs") nodeLogs.textContent = payload.logs || t("noData");
        await loadControls(); renderControlAudit(host);
        if (action === "restart") setTimeout(loadStatus, 1500);
      }

      async function loadStatus() {
        error.hidden = true; loadButton.disabled = true; loadButton.textContent = t("loading");
        try {
          const response = await fetch(statusApiUrl, { credentials: "same-origin" });
          const payload = await response.json().catch(() => ({}));
          if (response.status === 401 || response.status === 403) throw new Error(t("loginRequired"));
          if (payload.offline) throw new Error(t("offlineNotice"));
          if (!response.ok) throw new Error(payload.error || `Status API returned ${response.status}`);
          payloadCache = payload; await loadControls(); renderStatus(payload); await Promise.all([loadAvailability(), loadEvents(), loadMaintenance()]); lastUpdatedAt = new Date(); updated.textContent = `${t("updated")} ${lastUpdatedAt.toLocaleTimeString(language === "zh" ? "zh-CN" : "en-US")}`;
          startAutoRefresh();
        } catch (loadError) { overallDot.classList.add("is-down"); overallLabel.textContent = navigator.onLine ? t("offline") : t("offlineMode"); error.textContent = loadError instanceof Error ? loadError.message : t("loadFailed"); error.hidden = !navigator.onLine; }
        finally { loadButton.disabled = false; loadButton.textContent = t("refresh"); }
      }

      languageToggle.addEventListener("click", () => { language = language === "zh" ? "en" : "zh"; localStorage.setItem("dcc-language", language); applyLanguage(); });
      loadButton.addEventListener("click", loadStatus);
      historyRangeButtons.forEach((button) => button.addEventListener("click", () => loadHistory(button.dataset.historyRange)));
      historyHost.addEventListener("change", () => loadHistory(currentHistoryRange));
      historyExport.addEventListener("click", () => exportResource("metrics", { range: currentHistoryRange, host: historyHost.value }));
      eventType.addEventListener("change", loadEvents);
      eventsExport.addEventListener("click", () => exportResource("events", { type: eventType.value }));
      maintenanceAdd.addEventListener("click", addMaintenance);
      availabilityRangeButtons.forEach((button) => button.addEventListener("click", () => loadAvailability(button.dataset.availabilityRange)));
      document.addEventListener("click", (event) => { const target = event.target.closest("[data-service-host][data-service-name]"); if (target) openServiceDetail(target.dataset.serviceHost, target.dataset.serviceName); });
      document.addEventListener("click", (event) => { const target = event.target.closest("[data-node-host]"); if (target) openNodeDetail(target.dataset.nodeHost); });
      document.addEventListener("click", (event) => { const target = event.target.closest("[data-control-action]"); if (target) { event.stopPropagation(); runControlAction(target.dataset.controlAction, target.dataset.controlHost, target.dataset.controlName); } });
      document.addEventListener("click", (event) => { const target = event.target.closest("[data-maintenance-delete]"); if (target) { event.stopPropagation(); removeMaintenance(target.dataset.maintenanceDelete); } });
      serviceRangeButtons.forEach((button) => button.addEventListener("click", () => selectedService && openServiceDetail(selectedService.host, selectedService.name, button.dataset.serviceRange)));
      document.querySelector("[data-service-dialog-close]").addEventListener("click", () => serviceDialog.close());
      document.querySelector("[data-node-dialog-close]").addEventListener("click", () => nodeDialog.close());
      mobileNavItems.forEach((item) => item.addEventListener("click", () => { mobileNavItems.forEach((navItem) => navItem.classList.toggle("is-active", navItem === item)); }));
      pwaAction.addEventListener("click", () => noticeAction?.());
      pwaDismiss.addEventListener("click", hidePwaNotice);

      function startAutoRefresh() {
        window.clearInterval(autoRefreshTimer);
        autoRefreshTimer = window.setInterval(() => {
          if (document.visibilityState === "visible" && navigator.onLine) loadStatus();
        }, 300_000);
      }

      window.addEventListener("beforeinstallprompt", (event) => {
        event.preventDefault();
        deferredInstallPrompt = event;
        installButton.hidden = false;
      });
      installButton.addEventListener("click", async () => {
        if (deferredInstallPrompt) {
          deferredInstallPrompt.prompt();
          await deferredInstallPrompt.userChoice;
          deferredInstallPrompt = null;
          installButton.hidden = true;
        } else if (isIos) installDialog.showModal();
      });
      window.addEventListener("appinstalled", () => { deferredInstallPrompt = null; installButton.hidden = true; showPwaNotice("installed", null, null, "online"); });
      window.addEventListener("offline", () => updateNetworkState());
      window.addEventListener("online", () => { updateNetworkState({ recovered: true }); loadStatus(); serviceWorkerRegistration?.update(); });

      function offerServiceWorkerUpdate(registration) {
        if (!registration.waiting || !navigator.serviceWorker.controller) return;
        showPwaNotice("updateReady", "updateNow", () => {
          refreshingForUpdate = true;
          registration.waiting?.postMessage({ type: "SKIP_WAITING" });
        }, "update");
      }

      function decodeApplicationServerKey(value) {
        const padding = "=".repeat((4 - value.length % 4) % 4);
        const bytes = atob((value + padding).replace(/-/g, "+").replace(/_/g, "/"));
        return Uint8Array.from(bytes, (character) => character.charCodeAt(0));
      }

      async function configurePush(registration) {
        if (!("PushManager" in window) || !("Notification" in window)) return;
        try {
          const response = await fetch(apiUrl("push"), { credentials: "same-origin" });
          const config = await response.json();
          if (!response.ok || !config.enabled || !config.publicKey) return;
          const existing = await registration.pushManager.getSubscription();
          pushButton.hidden = false;
          pushButton.textContent = existing ? t("pushEnabled") : t("enablePush");
          pushButton.disabled = Boolean(existing);
          pushButton.onclick = async () => {
            const permission = await Notification.requestPermission();
            if (permission !== "granted") { showPwaNotice("pushDenied", null, null, "offline"); return; }
            const subscription = await registration.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: decodeApplicationServerKey(config.publicKey) });
            const saved = await fetch(apiUrl("push"), { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ subscription: subscription.toJSON() }) });
            if (saved.ok) { pushButton.textContent = t("pushEnabled"); pushButton.disabled = true; showPwaNotice("pushEnabled", null, null, "online"); }
          };
        } catch { /* Push remains optional when unsupported or unavailable. */ }
      }

      async function registerPwa() {
        if (!("serviceWorker" in navigator)) return;
        try {
          serviceWorkerRegistration = await navigator.serviceWorker.register("/dashboard/sw.js", { scope: "/dashboard/" });
          offerServiceWorkerUpdate(serviceWorkerRegistration);
          serviceWorkerRegistration.addEventListener("updatefound", () => {
            const worker = serviceWorkerRegistration.installing;
            worker?.addEventListener("statechange", () => {
              if (worker.state === "installed") offerServiceWorkerUpdate(serviceWorkerRegistration);
            });
          });
          const readyRegistration = await navigator.serviceWorker.ready;
          await configurePush(readyRegistration);
          const staticAssets = performance.getEntriesByType("resource")
            .map((entry) => entry.name)
            .filter((value) => {
              try {
                const url = new URL(value);
                return url.origin === window.location.origin && url.pathname.startsWith("/_astro/");
              } catch { return false; }
            });
          readyRegistration.active?.postMessage({ type: "CACHE_STATIC_ASSETS", urls: staticAssets });
        } catch (registrationError) {
          console.warn("PWA registration failed", registrationError);
        }
      }

      navigator.serviceWorker?.addEventListener("controllerchange", () => {
        if (refreshingForUpdate) window.location.reload();
      });
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible" && navigator.onLine) serviceWorkerRegistration?.update();
      });
      if (isIos && !isStandalone) installButton.hidden = false;
      window.addEventListener("load", registerPwa);
      updateNetworkState();
      applyLanguage();
      loadStatus();
    </script>
  </body>
</html>
