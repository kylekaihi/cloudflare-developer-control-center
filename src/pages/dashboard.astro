---
import "../styles/global.css";

const statusApiUrl = import.meta.env.PUBLIC_STATUS_API_URL || "/dashboard/api/status";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Cloudflare Developer Control Center" />
    <meta name="application-name" content="Developer Control Center" />
    <meta name="theme-color" content="#111615" />
    <meta name="color-scheme" content="dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Control Center" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="manifest" href="/dashboard/manifest.webmanifest" />
    <link rel="icon" href="/dashboard/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/dashboard/apple-touch-icon-180.png" />
    <title>Developer Control Center</title>
  </head>
  <body class="control-center" data-language="zh">
    <main class="control-shell" id="overview">
      <header class="control-header">
        <div>
          <p class="control-eyebrow" data-i18n="eyebrow">PRIVATE OPERATIONS / READ ONLY</p>
          <h1>Developer Control Center</h1>
          <p class="control-intro" data-i18n="intro">Cloudflare 管理面与 VPS 运行状态的只读视图。</p>
        </div>
        <div class="control-header-actions">
          <div class="control-header-meta"><span class="status-dot" data-overall-dot></span><span data-overall-label data-i18n="waiting">等待连接</span></div>
          <button class="install-button" type="button" data-install hidden data-i18n="install">安装</button>
          <button class="install-button" type="button" data-push hidden data-i18n="enablePush">启用通知</button>
          <button class="language-toggle" type="button" data-language-toggle>EN</button>
        </div>
      </header>

      <section class="control-toolbar" id="connection" data-i18n-attr="aria-label:toolbarLabel">
        <div class="access-identity"><span class="access-lock" aria-hidden="true">●</span><div><span data-i18n="accessLabel">CLOUDFLARE ACCESS</span><strong data-i18n="accessProtected">身份验证已启用</strong></div></div>
        <button type="button" data-load data-i18n="refresh">刷新状态</button>
        <span class="control-updated" data-updated data-i18n="notRead">尚未读取</span>
        <a class="access-logout" href="/cdn-cgi/access/logout" data-i18n="logout">退出</a>
      </section>

      <aside class="pwa-notice" data-pwa-notice role="status" aria-live="polite" hidden>
        <span class="pwa-notice-dot" aria-hidden="true"></span>
        <p data-pwa-message></p>
        <button class="pwa-notice-action" type="button" data-pwa-action hidden></button>
        <button class="pwa-notice-dismiss" type="button" data-pwa-dismiss data-i18n-attr="aria-label:dismiss">×</button>
      </aside>

      <p class="control-error" data-error hidden></p>

      <section class="metric-grid" data-i18n-attr="aria-label:metricsLabel">
        <article class="metric-card"><span data-i18n="cpu">CPU</span><strong data-metric="cpuPercent">—</strong><small data-i18n="load">负载</small></article>
        <article class="metric-card"><span data-i18n="memory">内存</span><strong data-metric="memoryPercent">—</strong><small data-i18n="used">已使用</small></article>
        <article class="metric-card"><span data-i18n="disk">磁盘</span><strong data-metric="diskPercent">—</strong><small data-i18n="used">已使用</small></article>
        <article class="metric-card"><span data-i18n="uptime">运行时间</span><strong data-metric="uptimeSeconds">—</strong><small data-uptime-label data-i18n="hostUptime">主机运行时间</small></article>
      </section>

      <section class="control-section" id="services-panel" aria-labelledby="services-title">
        <div class="control-section-heading"><div><p class="control-eyebrow">SERVICES</p><h2 id="services-title" data-i18n="services">运行中的服务</h2></div><span class="control-muted" data-service-count>—</span></div>
        <div class="service-list" data-services><p class="empty-state" data-i18n="serviceEmpty">正在等待首次状态读取。</p></div>
      </section>

      <section class="control-section control-section-compact" id="external-panel" aria-labelledby="external-title">
        <div class="control-section-heading"><div><p class="control-eyebrow">EXTERNAL AVAILABILITY</p><h2 id="external-title" data-i18n="externalChecks">外部可用性</h2></div><span class="control-muted" data-external-count>—</span></div>
        <div class="external-check-list" data-external-checks><p class="empty-state" data-i18n="externalEmpty">尚未配置外部检查。</p></div>
      </section>

      <div class="control-dual-grid">
        <section class="control-section control-section-compact" id="availability-panel" aria-labelledby="availability-title">
          <div class="control-section-heading"><div><p class="control-eyebrow">AVAILABILITY</p><h2 id="availability-title" data-i18n="availability">服务可用率</h2></div><div class="history-ranges"><button class="is-active" type="button" data-availability-range="7d">7D</button><button type="button" data-availability-range="30d">30D</button><button type="button" data-availability-range="since" data-i18n="since">部署以来</button></div></div>
          <div class="availability-list" data-availability><p class="empty-state" data-i18n="availabilityEmpty">等待服务历史数据。</p></div>
        </section>
        <section class="control-section control-section-compact" id="events-panel" aria-labelledby="events-title">
          <div class="control-section-heading"><div><p class="control-eyebrow">EVENT TIMELINE</p><h2 id="events-title" data-i18n="events">事件时间线</h2></div><div class="event-actions"><select data-event-type aria-label="Event type"><option value="" data-i18n="allEvents">全部事件</option><option value="incident_opened" data-i18n="failures">故障</option><option value="incident_resolved" data-i18n="recoveries">恢复</option><option value="deployment_changed" data-i18n="deployments">部署版本</option><option value="control_restart" data-i18n="operations">管理操作</option></select><button type="button" data-events-export>CSV</button><span class="control-muted" data-event-count>—</span></div></div>
          <div class="event-list" data-events><p class="empty-state" data-i18n="eventsEmpty">暂无运维事件。</p></div>
        </section>
      </div>

      <div class="control-dual-grid">
        <section class="control-section control-section-compact" id="alerts-panel" aria-labelledby="alerts-title">
          <div class="control-section-heading"><div><p class="control-eyebrow">ALERTS</p><h2 id="alerts-title" data-i18n="alerts">当前告警</h2></div><span class="control-muted" data-alert-count>—</span></div>
          <div class="alert-list" data-alerts><p class="empty-state" data-i18n="alertEmpty">读取状态后显示当前告警。</p></div>
        </section>

        <section class="control-section control-section-compact" id="trading-panel" aria-labelledby="trading-title">
          <div class="control-section-heading"><div><p class="control-eyebrow">TRADING SNAPSHOT</p><h2 id="trading-title" data-i18n="trading">交易摘要</h2></div><span class="control-muted" data-trading-status>—</span></div>
          <div class="summary-grid" data-trading><p class="empty-state" data-i18n="tradingEmpty">尚未配置交易摘要。</p></div>
        </section>
      </div>

      <section class="control-section control-section-compact" id="maintenance-panel" aria-labelledby="maintenance-title">
        <div class="control-section-heading"><div><p class="control-eyebrow">MAINTENANCE</p><h2 id="maintenance-title" data-i18n="maintenance">维护窗口</h2></div><div class="maintenance-actions"><button type="button" data-maintenance-add data-i18n="addMaintenance">新增窗口</button><span class="control-muted" data-maintenance-count>—</span></div></div>
        <div class="maintenance-list" data-maintenance><p class="empty-state" data-i18n="maintenanceEmpty">暂无维护窗口。</p></div>
      </section>

      <section class="control-section" id="nodes-panel" aria-labelledby="hosts-title">
        <div class="control-section-heading"><div><p class="control-eyebrow">VPS NODES</p><h2 id="hosts-title" data-i18n="nodes">Mesh 节点</h2></div><span class="control-muted" data-host-count>—</span></div>
        <div class="host-grid" data-hosts><p class="empty-state" data-i18n="nodeEmpty">读取状态后显示配置的 VPS 节点。</p></div>
      </section>

      <div class="control-dual-grid">
        <section class="control-section control-section-compact" id="deployments-panel" aria-labelledby="deployments-title">
          <div class="control-section-heading"><div><p class="control-eyebrow">DEPLOYMENTS</p><h2 id="deployments-title" data-i18n="deployments">部署版本</h2></div></div>
          <div class="deployment-list" data-deployments><p class="empty-state" data-i18n="deploymentEmpty">读取状态后显示部署版本。</p></div>
        </section>

        <section class="control-section control-section-compact" id="history-panel" aria-labelledby="history-title">
          <div class="control-section-heading"><div><p class="control-eyebrow">METRICS HISTORY</p><h2 id="history-title" data-i18n="history">指标历史</h2></div><div class="history-actions"><select data-history-host aria-label="VPS node"><option value="" data-i18n="allNodes">全部节点</option></select><div class="history-ranges" aria-label="Metrics range"><button class="is-active" type="button" data-history-range="1h">1H</button><button type="button" data-history-range="24h">24H</button><button type="button" data-history-range="7d">7D</button><button type="button" data-history-range="30d">30D</button></div><button type="button" class="history-export" data-history-export>CSV</button><span class="control-muted" data-history-count>—</span></div></div>
          <div class="history-panel" data-history><p class="empty-state" data-i18n="historyEmpty">刷新几次后显示指标历史。</p></div>
        </section>
      </div>

      <footer class="control-footer"><span data-i18n="stack">Cloudflare Pages · Workers VPC · Cloudflare Mesh</span><span data-i18n="readOnly">写操作受 Cloudflare Access 保护</span></footer>
    </main>

    <nav class="mobile-nav" aria-label="Mobile dashboard navigation" data-mobile-nav>
      <a class="mobile-nav-item is-active" href="#overview"><span class="mobile-nav-icon" aria-hidden="true">⌂</span><span data-i18n="navOverview">概览</span></a>
      <a class="mobile-nav-item" href="#services-panel"><span class="mobile-nav-icon" aria-hidden="true">≡</span><span data-i18n="navServices">服务</span></a>
      <a class="mobile-nav-item" href="#nodes-panel"><span class="mobile-nav-icon" aria-hidden="true">◎</span><span data-i18n="navNodes">节点</span></a>
      <a class="mobile-nav-item" href="#alerts-panel"><span class="mobile-nav-icon" aria-hidden="true">!</span><span data-i18n="navAlerts">告警</span><b class="mobile-nav-badge" data-mobile-alert-count hidden>0</b></a>
    </nav>

    <dialog class="install-dialog" data-install-dialog aria-labelledby="install-dialog-title">
      <form method="dialog">
        <div class="install-dialog-icon" aria-hidden="true"><img src="/dashboard/icon-192.png" alt="" /></div>
        <div>
          <h2 id="install-dialog-title" data-i18n="installTitle">安装 Control Center</h2>
          <p data-i18n="installIos">在 Safari 中点击“共享”，然后选择“添加到主屏幕”。</p>
        </div>
        <button type="submit" data-i18n="close">知道了</button>
      </form>
    </dialog>

    <dialog class="service-dialog" data-service-dialog aria-labelledby="service-dialog-title">
      <div class="service-dialog-shell">
        <header><div><p class="control-eyebrow">SERVICE DETAIL</p><h2 id="service-dialog-title" data-service-dialog-title>—</h2><p data-service-dialog-host>—</p></div><button type="button" data-service-dialog-close aria-label="Close">×</button></header>
        <div class="service-detail-metrics" data-service-detail-metrics></div>
        <div class="history-ranges service-detail-ranges"><button class="is-active" type="button" data-service-range="24h">24H</button><button type="button" data-service-range="7d">7D</button><button type="button" data-service-range="30d">30D</button><button type="button" data-service-range="since" data-i18n="since">部署以来</button></div>
        <div class="service-detail-chart" data-service-detail-chart><p class="empty-state" data-i18n="historyEmpty">等待定时采集产生历史数据。</p></div>
      </div>
    </dialog>

    <dialog class="service-dialog node-dialog" data-node-dialog aria-labelledby="node-dialog-title">
      <div class="service-dialog-shell">
        <header><div><p class="control-eyebrow">VPS MANAGEMENT / READ ONLY</p><h2 id="node-dialog-title" data-node-dialog-title>—</h2><p data-node-dialog-address>—</p></div><button type="button" data-node-dialog-close aria-label="Close">×</button></header>
        <div class="node-facts" data-node-facts></div>
        <section class="node-detail-section"><h3 data-i18n="storage">存储</h3><div class="node-detail-list" data-node-storage></div></section>
        <section class="node-detail-section"><h3 data-i18n="network">私有网络</h3><div class="node-detail-list" data-node-network></div></section>
        <section class="node-detail-section"><h3 data-i18n="services">运行中的服务</h3><div class="node-detail-list" data-node-services></div></section>
        <section class="node-detail-section"><h3 data-i18n="serviceLogs">服务日志</h3><pre class="control-logs" data-node-logs data-i18n="selectLogs">选择“日志”读取最近输出。</pre></section>
        <section class="node-detail-section"><h3 data-i18n="auditLog">操作审计</h3><div class="node-detail-list" data-control-audit></div></section>
      </div>
    </dialog>

    <script is:inline define:vars={{ statusApiUrl }}>
      const loadButton = document.querySelector("[data-load]");
      const error = document.querySelector("[data-error]");
      const updated = document.querySelector("[data-updated]");
      const overallDot = document.querySelector("[data-overall-dot]");
      const overallLabel = document.querySelector("[data-overall-label]");
      const services = document.querySelector("[data-services]");
      const serviceCount = document.querySelector("[data-service-count]");
      const externalChecks = document.querySelector("[data-external-checks]");
      const externalCount = document.querySelector("[data-external-count]");
      const alerts = document.querySelector("[data-alerts]");
      const alertCount = document.querySelector("[data-alert-count]");
      const maintenance = document.querySelector("[data-maintenance]");
      const maintenanceAdd = document.querySelector("[data-maintenance-add]");
      const maintenanceCount = document.querySelector("[data-maintenance-count]");
      const trading = document.querySelector("[data-trading]");
      const tradingStatus = document.querySelector("[data-trading-status]");
      const hosts = document.querySelector("[data-hosts]");
      const hostCount = document.querySelector("[data-host-count]");
      const deployments = document.querySelector("[data-deployments]");
      const historyPanel = document.querySelector("[data-history]");
      const historyCount = document.querySelector("[data-history-count]");
      const historyRangeButtons = [...document.querySelectorAll("[data-history-range]")];
      const historyHost = document.querySelector("[data-history-host]");
      const historyExport = document.querySelector("[data-history-export]");
      const availability = document.querySelector("[data-availability]");
      const availabilityRangeButtons = [...document.querySelectorAll("[data-availability-range]")];
      const events = document.querySelector("[data-events]");
      const eventCount = document.querySelector("[data-event-count]");
      const eventType = document.querySelector("[data-event-type]");
      const eventsExport = document.querySelector("[data-events-export]");
      const serviceDialog = document.querySelector("[data-service-dialog]");
      const serviceDialogTitle = document.querySelector("[data-service-dialog-title]");
      const serviceDialogHost = document.querySelector("[data-service-dialog-host]");
      const serviceDetailMetrics = document.querySelector("[data-service-detail-metrics]");
      const serviceDetailChart = document.querySelector("[data-service-detail-chart]");
      const serviceRangeButtons = [...document.querySelectorAll("[data-service-range]")];
      const nodeDialog = document.querySelector("[data-node-dialog]");
      const nodeDialogTitle = document.querySelector("[data-node-dialog-title]");
      const nodeDialogAddress = document.querySelector("[data-node-dialog-address]");
      const nodeFacts = document.querySelector("[data-node-facts]");
      const nodeStorage = document.querySelector("[data-node-storage]");
      const nodeNetwork = document.querySelector("[data-node-network]");
      const nodeServices = document.querySelector("[data-node-services]");
      const nodeLogs = document.querySelector("[data-node-logs]");
      const controlAudit = document.querySelector("[data-control-audit]");
      const languageToggle = document.querySelector("[data-language-toggle]");
      const installButton = document.querySelector("[data-install]");
      const pushButton = document.querySelector("[data-push]");
      const mobileAlertCount = document.querySelector("[data-mobile-alert-count]");
      const mobileNavItems = [...document.querySelectorAll("[data-mobile-nav] .mobile-nav-item")];
      const pwaNotice = document.querySelector("[data-pwa-notice]");
      const pwaMessage = document.querySelector("[data-pwa-message]");
      const pwaAction = document.querySelector("[data-pwa-action]");
      const pwaDismiss = document.querySelector("[data-pwa-dismiss]");
      const installDialog = document.querySelector("[data-install-dialog]");
      const body = document.body;
      const copy = {
        zh: { eyebrow: "PRIVATE OPERATIONS / READ ONLY", intro: "Cloudflare 管理面与 VPS 运行状态的只读视图。", waiting: "等待连接", connected: "全部在线", partial: "部分在线", offline: "连接失败", noServices: "无服务数据", availability: "服务可用率", availabilityEmpty: "等待服务历史数据。", events: "事件时间线", eventsEmpty: "暂无运维事件。", allEvents: "全部事件", failures: "故障", recoveries: "恢复", operations: "管理操作", allNodes: "全部节点", availabilityLabel: "可用率", averageLatency: "平均延迟", samples: "采样", since: "部署以来", storage: "存储", network: "私有网络", distribution: "系统", kernel: "内核", architecture: "架构", cpuModel: "处理器", loadAverage: "系统负载", memoryUsage: "内存用量", noData: "暂无数据", serviceLogs: "服务日志", selectLogs: "选择“日志”读取最近输出。", auditLog: "操作审计", viewLogs: "日志", restartService: "重启", restartPrompt: "输入服务名称以确认重启", actionFailed: "操作失败", coverage: "数据覆盖", accumulating: "数据积累中", detailLoading: "正在读取服务历史…", enablePush: "启用通知", pushEnabled: "通知已启用", pushDenied: "通知权限被拒绝", toolbarLabel: "状态连接", accessLabel: "CLOUDFLARE ACCESS", accessProtected: "身份验证已启用", logout: "退出", refresh: "刷新状态", install: "安装", loading: "读取中…", notRead: "尚未读取", metricsLabel: "系统指标", cpu: "CPU", memory: "内存", disk: "磁盘", uptime: "运行时间", load: "负载", used: "已使用", hostUptime: "主机运行时间", services: "运行中的服务", nodes: "Mesh 节点", serviceEmpty: "正在等待首次状态读取。", nodeEmpty: "读取状态后显示配置的 VPS 节点。", externalChecks: "外部可用性", externalEmpty: "尚未配置外部检查。", httpStatus: "HTTP 状态", latency: "延迟", tlsExpiry: "证书剩余", days: "天", alerts: "当前告警", alertEmpty: "暂无活动告警。", maintenance: "维护窗口", maintenanceEmpty: "暂无维护窗口。", addMaintenance: "新增窗口", maintenanceGlobal: "全部节点", maintenanceUntil: "结束", maintenanceReason: "原因", removeMaintenance: "删除", maintenancePromptHost: "节点地址（留空表示全部节点）", maintenancePromptService: "服务名（留空表示整个节点）", maintenancePromptMinutes: "持续分钟数", maintenancePromptReason: "维护原因", maintenanceCreated: "维护窗口已创建。", maintenanceFailed: "维护窗口操作失败。", trading: "交易摘要", tradingEmpty: "尚未配置交易摘要。", pnl: "PnL", positions: "持仓", exposure: "敞口", balance: "余额", deployments: "部署版本", deploymentEmpty: "暂无部署版本数据。"