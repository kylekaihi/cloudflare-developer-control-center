{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "blog-image-uploader",
  "main": "src/index.js",
  "compatibility_date": "2026-05-16",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "BLOG_IMAGES",
      "bucket_name": "developer-control-center-images"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://images.example.com",
    "MAX_UPLOAD_BYTES": "20971520"
  }
}
